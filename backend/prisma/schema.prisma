// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  STAFF
  ADMIN
}

enum StaffRole {
  DOCTOR
  NURSE
}

model Hospital {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  address             String?
  timeZone            String?
  logoUrl             String?
  accessCode          String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  users               User[]
  departments         Department[]
  notificationSetting NotificationSetting?

  @@map("hospitals")
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  gender       String?
  hospitalName String?
  password     String
  role         Role     @default(PATIENT)
  staffRole    StaffRole?
  isPrimary    Boolean  @default(false)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)

  hospitalId   String?  @db.ObjectId
  hospital     Hospital? @relation(fields: [hospitalId], references: [id])

  departmentId String?  @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id])

  passwordResetTokens PasswordResetToken[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Department {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  shortCode  String
  status     String   @default("ACTIVE")
  hospitalId String   @db.ObjectId

  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff      User[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([hospitalId, shortCode])
  @@map("departments")
}

model NotificationSetting {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  hospitalId                String   @unique @db.ObjectId

  patientEmailEnabled       Boolean  @default(true)
  patientEmailTemplate      String?

  staffAnnouncementsEnabled Boolean  @default(true)
  staffOvercapacityEnabled  Boolean  @default(true)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  hospital                  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}
