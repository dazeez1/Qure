// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  ADMIN
}

enum StaffRole {
  DOCTOR
  NURSE
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  MOVED_TO_QUEUE
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  TRIAGE
  CALLED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementAudience {
  PATIENT
  STAFF
  BOTH
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER_24H
  APPOINTMENT_REMINDER_2H
  APPOINTMENT_CANCELLATION
  APPOINTMENT_RESCHEDULE
  QUEUE_STATUS_CHANGE
  QUEUE_CANCELLATION
  FEEDBACK_REQUEST
  WAIT_TIME_UPDATE
  ANNOUNCEMENT
  APPOINTMENT_MESSAGE
}

model WaitingArea {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  floor    String?
  facility String?
  capacity Int

  hospitalId String   @db.ObjectId
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  queueEntries QueueEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, name])
  @@map("waiting_areas")
}

model Hospital {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  address            String?
  timeZone           String?
  logoUrl            String?
  accessCode         String   @unique
  accessCodeRequired Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users                User[]
  departments          Department[]
  notificationSetting  NotificationSetting?
  appointments         Appointment[]
  queueEntries         QueueEntry[]
  rooms                Room[]
  waitingAreas         WaitingArea[]
  announcements        Announcement[]
  feedbacks            Feedback[]
  supportMessages      SupportMessage[]
  patientNotifications PatientNotification[]

  @@map("hospitals")
}

model User {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  firstName             String
  lastName              String
  email                 String     @unique
  phone                 String?
  gender                String?
  hospitalName          String?
  password              String
  role                  Role
  staffRole             StaffRole?
  isAvailable           Boolean    @default(true)
  currentActivePatients Int        @default(0)
  maxConcurrentPatients Int        @default(3)
  isPrimary             Boolean    @default(false)
  isVerified            Boolean    @default(false)
  isActive              Boolean    @default(true)

  hospitalId String?   @db.ObjectId
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  departmentId String?     @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id])

  assignedQueueEntries QueueEntry[]
  createdAnnouncements Announcement[]
  feedbacks            Feedback[]

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String?  @db.ObjectId // Made optional to support patients
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId String?  @db.ObjectId // Added for patient password resets
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Department {
  id                             String @id @default(auto()) @map("_id") @db.ObjectId
  name                           String
  shortCode                      String
  status                         String @default("ACTIVE")
  hospitalId                     String @db.ObjectId
  defaultConsultationTimeMinutes Int    @default(15) // Admin-configurable default
  avgConsultationTimeMinutes     Float? // Calculated from historical data

  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff           User[]
  appointments    Appointment[]
  queueEntries    QueueEntry[]
  rooms           Room[]
  waitTimeMetrics WaitTimeMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, shortCode])
  @@map("departments")
}

model NotificationSetting {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  hospitalId String @unique @db.ObjectId

  patientEmailEnabled  Boolean @default(true)
  patientEmailTemplate String?

  staffAnnouncementsEnabled Boolean @default(true)
  staffOvercapacityEnabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model Patient {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId
  fullName                  String
  email                     String    @unique
  password                  String
  phone                     String?
  gender                    String?
  dateOfBirth               DateTime?
  avatarUrl                 String?
  emailNotificationsEnabled Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  appointments        Appointment[]
  queueEntries        QueueEntry[]
  passwordResetTokens PasswordResetToken[]
  feedbacks           Feedback[]
  supportMessages     SupportMessage[]
  PatientNotification PatientNotification[]

  @@map("patients")
}

model Appointment {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  patientId       String            @db.ObjectId
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId      String            @db.ObjectId
  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departmentId    String            @db.ObjectId
  department      Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  appointmentDate DateTime
  status          AppointmentStatus @default(BOOKED)
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  queueEntry QueueEntry?
  feedbacks  Feedback[]

  @@index([hospitalId, status])
  @@index([hospitalId, appointmentDate])
  @@index([departmentId, status])
  @@map("appointments")
}

model QueueEntry {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  patientId        String        @db.ObjectId
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId    String?       @unique @db.ObjectId
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  hospitalId       String        @db.ObjectId
  hospital         Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departmentId     String        @db.ObjectId
  department       Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignedDoctorId String?       @db.ObjectId
  assignedDoctor   User?         @relation(fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  assignedRoomId   String?       @db.ObjectId
  assignedRoom     Room?         @relation(fields: [assignedRoomId], references: [id], onDelete: SetNull)
  waitingAreaId    String?       @db.ObjectId
  waitingArea      WaitingArea?  @relation(fields: [waitingAreaId], references: [id], onDelete: SetNull)
  ticketNumber     String
  sequenceNumber   Int
  status           QueueStatus   @default(WAITING)
  priority         PriorityLevel @default(NORMAL)
  checkInTime      DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([hospitalId, departmentId, ticketNumber])
  @@index([hospitalId, status])
  @@index([hospitalId, departmentId, status])
  @@index([assignedDoctorId, status])
  @@index([checkInTime])
  @@index([status, priority])
  @@map("queue_entries")
}

model Room {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  hospitalId   String     @db.ObjectId
  hospital     Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  departmentId String     @db.ObjectId
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  queueEntries QueueEntry[]

  @@unique([hospitalId, departmentId, name])
  @@map("rooms")
}

model Announcement {
  id         String               @id @default(auto()) @map("_id") @db.ObjectId
  hospitalId String               @db.ObjectId
  hospital   Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  audience   AnnouncementAudience
  title      String
  content    String
  priority   AnnouncementPriority @default(NORMAL)
  isActive   Boolean              @default(true)
  createdBy  String?              @db.ObjectId
  creator    User?                @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  patientNotifications PatientNotification[]

  @@map("announcements")
}

model PatientNotification {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  patientId      String               @db.ObjectId
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  announcementId String?              @db.ObjectId
  announcement   Announcement?        @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  content        String
  category       String // APPOINTMENT, QUEUE, FEEDBACK, ANNOUNCEMENT
  priority       AnnouncementPriority @default(NORMAL)
  isRead         Boolean              @default(false)
  readAt         DateTime?
  hospitalId     String               @db.ObjectId
  hospital       Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([patientId, isRead])
  @@index([patientId, createdAt])
  @@map("patient_notifications")
}

model WaitTimeMetric {
  id                         String     @id @default(auto()) @map("_id") @db.ObjectId
  departmentId               String     @db.ObjectId
  department                 Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  hospitalId                 String     @db.ObjectId
  date                       DateTime // Date only (time set to 00:00:00)
  avgWaitTimeMinutes         Float // Average wait time for the day
  totalCompleted             Int        @default(0) // Number of completed consultations
  totalNoShows               Int        @default(0) // Number of no-shows
  totalCancelled             Int        @default(0) // Number of cancelled
  avgConsultationTimeMinutes Float? // Average consultation time for the day
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  @@unique([departmentId, date])
  @@index([hospitalId, date])
  @@map("wait_time_metrics")
}

model Feedback {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  rating  Int
  comment String?

  patientId     String  @db.ObjectId
  appointmentId String  @db.ObjectId
  doctorId      String? @db.ObjectId
  hospitalId    String  @db.ObjectId

  createdAt DateTime @default(now())

  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      User?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([patientId, appointmentId])
  @@index([hospitalId, createdAt])
  @@index([doctorId])
  @@map("feedbacks")
}

model SupportMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String
  message    String
  hospitalId String?  @db.ObjectId
  patientId  String?  @db.ObjectId
  createdAt  DateTime @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  patient  Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([hospitalId])
  @@index([patientId])
  @@map("support_messages")
}
